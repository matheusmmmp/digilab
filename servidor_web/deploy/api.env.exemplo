# O modelo do /etc/digilab/api.env na VPS (CN5). SÓ OS NOMES: os valores vão no arquivo da VPS, nunca no repositório.
# As variáveis estão descritas em servidor_web/src/conta/config.ts e servidor_web/CLAUDE.md.
DIGILAB_BORDA=cloudflare
DIGILAB_BANCO=/var/lib/digilab/conta.sqlite
DIGILAB_GASTO_FALA=/var/lib/digilab/gasto_fala.json
# https://api.<domínio> e https://<domínio>/jogo/ (RC-6)
DIGILAB_URL_API=
DIGILAB_URL_JOGO=
DIGILAB_PROVEDOR_FALSO=0
# os convidados (CN-10), separados por vírgula, no formato da servidor_web/src/conta/convidados.ts
DIGILAB_CONVIDADOS=
# o beta usa o 7 (BT0-1, D-CONTA-76)
DIGILAB_MARCO_RANQUEADA=
# os apps OAuth (o Matheus cria; sem elas, o provedor fica desligado)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# a fala pela LLM; sem ela, só o template
ANTHROPIC_API_KEY=
