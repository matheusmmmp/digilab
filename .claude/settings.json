{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/h1_engine.py\"", "timeout": 30}]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/h3_main.py\"", "timeout": 30}]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/h1b_engine_sha.py\"", "timeout": 30}
        ]
      }
    ]
  }
}
